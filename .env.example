# Server
PORT=3001
JWT_SECRET=change_this_to_a_secure_random_string

# Database
# When running with Docker Compose these are injected automatically
# (DB_HOST becomes "db"). For local (non-Docker) runs they fall back to XAMPP.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=spotify_db
DB_USER=root
DB_PASSWORD=
