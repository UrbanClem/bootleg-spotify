# Loaded by `npm run build:demo` (vite --mode demo).
#
# VITE_API_URL points the static frontend at the Render-hosted API, so the
# published app talks to the real backend instead of the in-browser mock.
# VITE_DEMO is intentionally unset — the mock is only for local browsing.
VITE_API_URL=https://bootleg-spotify.onrender.com/api
